ZERO_COST_ONLY=true
BIDPILOT_HOST=127.0.0.1
BIDPILOT_PORT=8080
BIDPILOT_DB=data/bidpilot.sqlite3
# Set a random value of at least 32 characters before enabling admin HTTP refresh.
BIDPILOT_ADMIN_TOKEN=
# Production hostname; comma-separated additional hostnames, no scheme.
BIDPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
# Secure cookies on a TLS production deployment.
BIDPILOT_SECURE_COOKIE=false
# In-process daily schedule works only while the server process is running.
BIDPILOT_SCHEDULER=true
